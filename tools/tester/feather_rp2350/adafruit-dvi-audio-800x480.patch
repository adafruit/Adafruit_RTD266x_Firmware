+void hstx_packet_clear_avi_aspect(hstx_packet_t *packet)
+{
+    // 800x480 has no CTA VIC or representable 4:3/16:9 picture ratio.
+    // A=0 and M=0 leave the sink to measure the explicitly timed raster.
+    packet->subpacket[0][0] = 0;
+    packet->subpacket[0][1] &= (uint8_t)~0x10;
+    packet->subpacket[0][2] = 0;
+    compute_infoframe_checksum(packet);
+    compute_all_parity(packet);
+}
+
 // SPD InfoFrame: type 0x83, version 1, 25 payload bytes -- PB1..PB8 vendor,
 // PB9..PB24 product, PB25 Source Device Information. Payload byte n lives at
 // subpacket[n / 7][n % 7] (PB0 is the checksum), the same layout
